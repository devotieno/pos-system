# --- Client-side Firebase config (safe to expose to the browser) ---
# Firebase console -> Project settings -> General -> Your apps -> Web app -> SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Server-only Firebase Admin credentials (NEVER prefix these with NEXT_PUBLIC_) ---
# Firebase console -> Project settings -> Service accounts -> Generate new private key
# That downloads a JSON file - copy the matching fields from it below.
# Used by: the bootstrap script (npm run create-owner) and app/api/staff (creating/editing users).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the full "private_key" value from the JSON file, including -----BEGIN/END PRIVATE KEY-----.
# Keep it wrapped in quotes and keep the \n sequences as literal \n (don't turn them into real
# line breaks) - the app converts them back automatically.
FIREBASE_ADMIN_PRIVATE_KEY=""
